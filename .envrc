# nix-direnv only watches flake.nix nd flake.lock, so th shell's own inputs have 2 b listed b4
# `use flake` or editing them never invalidates th cached shell
watch_file nix/packages/shell.nix nix/overlays/default.nix
watch_dir nix/packages/zoomies
use flake ./nix

export VAULT_ADDR=https://bao.t4t.net:8200
